# Application
APP_NAME=AI-Powered Document Intelligence
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/document_intelligence

# RabbitMQ
RABBITMQ_URL=amqp://YOUR_RABBITMQ_USER:YOUR_RABBITMQ_PASSWORD@localhost:5672/YOUR_VHOST

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Tesseract OCR
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Upload configuration
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads
PROCESSED_DIR=processed




